{
  "name": "sunset-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "python3 tools/build_data.py",
    "render:images": "node tools/render_trees.cjs",
    "clave": "python3 tools/new_key.py",
    "test": "node --test tests/*.test.mjs",
    "push:claves": "node -e \"const k=require('web-push').generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\\nVAPID_PRIVATE_KEY='+k.privateKey)\"",
    "test:e2e": "node --test --test-concurrency=2 tests/e2e/*.e2e.mjs",
    "test:todo": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "playwright": "1.63.0"
  }
}
